---
import { ViewTransitions } from "astro:transitions";
interface Props {
	title: string;
	description?: string;
}

const {
	title,
	description =
		"Consultoría tecnológica para PyMEs en Chile: optimiza tu equipo de desarrollo, construye software a medida y convierte tus datos en decisiones. Método claro y precios sin sorpresas.",
} = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
const ogImage = Astro.site ? new URL("/og.png", Astro.site) : undefined;
import "@/styles/style.css";

import Navigation from "../components/Navigation.astro";
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link
			rel="icon"
			href={`/favicon.ico`}
		/>
		<link
			rel="canonical"
			href={canonical}
		/>
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content={description}
		/>
		<meta
			name="keywords"
			content="consultoría tecnológica, desarrollo de software, PyMEs Chile, DevOps, arquitectura de software, ciencia de datos, dashboards, machine learning"
		/>
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="BGM Solutions" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<title>{title}</title>
		<link
			rel="stylesheet"
			href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
		/>
		<style>
			@import url('https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&family=Ubuntu+Mono:ital,wght@0,400;0,700;1,400;1,700&family=Ubuntu:ital,wght@0,300;0,400;0,500;0,700;1,300;1,400;1,500;1,700&display=swap');
		</style>
		<ViewTransitions />
	</head>
	<body>
		<main>
			<Navigation />
			<slot />
			<script src="../scripts/main.js"></script>
		</main>
	</body>
</html>