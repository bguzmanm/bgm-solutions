<header class="con-hero">
    <div class="container con-hero-inner">
        <div class="con-hero-copy">
            <p class="term-eyebrow"><span class="term-prompt">&gt;</span> /consultoria</p>
            <h1>Tu equipo de tecnología pierde millones en silencio.</h1>
            <p class="hero-subtitle">
                Detectamos qué se está rompiendo, cuánto te cuesta en pesos y qué
                cambiar primero. Un diagnóstico de 10 días, sin venderte tecnología
                innecesaria.
            </p>
            <div class="hero-cta">
                <a
                    href="https://calendar.app.google/4occ12N5XGe6aqYf8"
                    target="_blank"
                    class="btn-primary">Agendar reunión de 15/30 min.</a
                >
            </div>
        </div>

        <div class="con-panel" aria-hidden="true">
            <div class="con-panel-head">
                <span>Auditoría en curso</span>
                <span class="con-live"><i class="fas fa-circle"></i> escaneando</span>
            </div>

            <div class="con-log">
                <p class="con-log-line" style="--d: 0s;"><span class="con-ok">$</span> bgm audit --equipo-dev</p>
                <p class="con-log-line" style="--d: 0.35s;"><span class="con-ok">&#10003;</span> escaneando repositorios</p>
                <p class="con-log-line" style="--d: 0.7s;"><span class="con-ok">&#10003;</span> midiendo deuda técnica</p>
                <p class="con-log-line" style="--d: 1.05s;"><span class="con-warn">!</span> 3 hallazgos críticos</p>
            </div>

            <div class="con-findings">
                <div class="con-finding">
                    <span class="con-finding-tag"><span class="con-sev con-sev-crit"></span>CRÍTICO · deuda técnica</span>
                    <span class="con-finding-cost">&#8776; 40 MM/año</span>
                </div>
                <div class="con-finding">
                    <span class="con-finding-tag"><span class="con-sev con-sev-high"></span>ALTO · bugs recurrentes</span>
                    <span class="con-finding-cost">&#8776; 18 MM/año</span>
                </div>
                <div class="con-finding">
                    <span class="con-finding-tag"><span class="con-sev con-sev-med"></span>MEDIO · procesos manuales</span>
                    <span class="con-finding-cost">&#8776; 12 MM/año</span>
                </div>
            </div>
        </div>
    </div>
</header>