---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import ScrollTop from "../components/ScrollTop.astro";
import HeroScience from "../components/HeroScience.astro";
import CallToAction from "../components/CallToAction.astro";
---

<Layout title="BGM Solutions - Análisis y Ciencia de Datos">
    <HeroScience />

    <section class="container section-padding">
        <h2 class="section-title text-center">
            El poder de los datos a tu favor
        </h2>
        <div class="grid-problems" style="margin-top: 40px;">
            <div class="card">
                <i class="fas fa-chart-line"></i>
                <h3>Business Intelligence</h3>
                <p>
                    Dashboards interactivos y reportes automatizados para
                    visualizar KPIs en tiempo real.
                </p>
            </div>
            <div class="card">
                <i class="fas fa-brain"></i>
                <h3>Modelos Predictivos</h3>
                <p>
                    Utilizamos Machine Learning para predecir tendencias y
                    optimizar la toma de decisiones.
                </p>
            </div>
            <div class="card">
                <i class="fas fa-database"></i>
                <h3>Ingeniería de Datos</h3>
                <p>
                    Arquitectura y pipelines de datos para recolectar, limpiar y
                    almacenar tu información.
                </p>
            </div>
            <div class="card">
                <i class="fas fa-chart-pie"></i>
                <h3>Análisis Descriptivo</h3>
                <p>
                    Diagnóstico del estado actual de tu negocio para descubrir
                    oportunidades de mejora inmediatas.
                </p>
            </div>
            <div class="card">
                <i class="fas fa-microscope"></i>
                <h3>Data Mining</h3>
                <p>
                    Descubre patrones ocultos, segmentaciones de clientes y
                    relaciones que tu data no te está contando.
                </p>
            </div>
            <div class="card">
                <i class="fas fa-robot"></i>
                <h3>Automatización Inteligente</h3>
                <p>
                    Procesos repetitivos automatizados con datos en el centro,
                    liberando a tu equipo para lo importante.
                </p>
            </div>
        </div>
    </section>

    <section class="bg-dark-alt section-padding">
        <div class="container text-center">
            <h2 class="section-title">¿Cómo empezamos?</h2>
            <p style="color: #aaa; max-width: 700px; margin: 0 auto 40px;">
                Un método claro y sin humo para convertir tus datos en decisiones.
            </p>
            <div class="timeline-container" style="text-align: left;">
                <div class="timeline-step">
                    <div class="step-header"><span>Semana 1</span> Descubrimiento</div>
                    <p>
                        Entendemos tu negocio, auditamos tus datos y definimos
                        qué preguntas realmente importan.
                    </p>
                </div>
                <div class="timeline-step">
                    <div class="step-header"><span>Semana 2</span> Quick Win</div>
                    <p>
                        Entregamos un primer dashboard o análisis de alto
                        impacto para validar el valor en semanas, no meses.
                    </p>
                </div>
                <div class="timeline-step highlight">
                    <div class="step-header"><span>Semana 4</span> Entrega y Roadmap</div>
                    <p>
                        Presentamos resultados accionables y definimos la hoja
                        de ruta para escalar.
                    </p>
                    <div class="deliverables-box">
                        <h4>Recibirás:</h4>
                        <ul class="deliverables-list">
                            <li><i class="fas fa-check"></i> Dashboard interactivo funcional</li>
                            <li><i class="fas fa-check"></i> Informe ejecutivo con insights</li>
                            <li><i class="fas fa-check"></i> Roadmap de datos a 90 días</li>
                            <li><i class="fas fa-check"></i> Recomendaciones de stack y costos</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="container section-padding text-center">
        <h2 class="section-title">Resultados medibles en semanas</h2>
        <div class="roi-grid">
            <div class="roi-item">
                <span class="roi-value">+40%</span>
                <p>Precisión en pronósticos de demanda</p>
            </div>
            <div class="roi-item">
                <span class="roi-value">-30%</span>
                <p>Costos operativos detectados</p>
            </div>
            <div class="roi-item">
                <span class="roi-value">2x</span>
                <p>Velocidad en la toma de decisiones</p>
            </div>
        </div>
    </section>

    <CallToAction title="Descubre el valor oculto en tus datos" paragraph="Hablemos sobre cómo podemos aplicar la ciencia de datos a los
            desafíos de tu negocio."/>

    <Footer />
    <ScrollTop />
</Layout>