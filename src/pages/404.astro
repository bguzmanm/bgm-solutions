---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404 — Página no encontrada" description="La página que buscas no existe o ha sido movida.">
    <section class="container section-padding text-center not-found">
        <p class="term-eyebrow"><span class="term-prompt">$</span> 404</p>
        <h1>404</h1>
        <p class="hero-subtitle">
            La página que buscas no existe o ha sido movida.
        </p>
        <div class="hero-cta">
            <a href="/" class="btn-primary">Volver al inicio</a>
        </div>
    </section>
</Layout>